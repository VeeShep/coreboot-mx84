/dts-v1/;

/ {
	description = "Free Linux rescue environment for Cisco Meraki MX84";
	#address-cells = <1>;
	meraki-build = "mx84-buildroot-2026.05.1-milesfix1";

	images {
		kernel-1 {
			description = "Linux 6.18.7 kernel";
			data = /incbin/("bzImage");
			type = "kernel";
			arch = "x86";
			os = "linux";
			compression = "none";
			load = <0x00008000>;
			entry = <0x00008000>;
			hash-1 {
				algo = "sha1";
			};
		};

		ramdisk-1 {
			description = "Buildroot initramfs";
			data = /incbin/("rootfs.cpio.gz");
			type = "ramdisk";
			arch = "x86";
			os = "linux";
			compression = "gzip";
			hash-1 {
				algo = "sha1";
			};
		};
	};

	configurations {
		default = "config-1";
		config-1 {
			description = "MX84 serial rescue console (Miles init_size fallback)";
			kernel = "kernel-1";
			ramdisk = "ramdisk-1";
			command-line = "console=ttyS1,115200n8 earlyprintk=serial,ttyS1,115200 earlycon=uart8250,io,0x2f8,115200n8 loglevel=8 rdinit=/sbin/init gpio-ich.initial_dir=0xFDFFFFEF,0xF785FFF3 gpio-ich.initial_vals=0x02000010,0x0078000C MERAKI_BOARD=pocahontas";
		};
	};
};
